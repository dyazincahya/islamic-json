    {
      "id": "block.daily-parents-example",
      "type": "paragraph",
      "text": {
        "id": "Seseorang membantu urusan kesehatan atau digital sambil menghormati pilihan orang tuanya.",
        "en": "A person helps with health or digital matters while respecting parental choices."
      }
    },
    {
