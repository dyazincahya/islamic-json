    {
      "id": "block.daily-parents-explanation",
      "type": "paragraph",
      "text": {
        "id": "Perhatian kepada orang tua menjaga martabat mereka sambil memberi bantuan yang berguna.",
        "en": "Care for parents preserves their dignity while offering useful help."
      }
    },
    {
      "id": "block.daily-parents-example-heading",
