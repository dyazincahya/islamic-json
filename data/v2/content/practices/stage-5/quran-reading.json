      "type": "paragraph",
      "text": {
        "id": "Utamakan ketepatan sebelum kecepatan tanpa menyalin data Al-Quran ke dokumen ini.",
        "en": "Prioritize accuracy before speed without copying Quran data into this document."
      }
    },
    {
      "id": "block.quran-reading-steps",
