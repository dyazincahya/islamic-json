      "items": [
        {
          "id": "step.quran-reading-1",
          "title": {
            "id": "Lihat",
            "en": "Observe"
          },
          "body": {
            "id": "Amati huruf dan harakat sebelum membaca.",
            "en": "Observe letters and marks before reading."
          }
        },
        {
          "id": "step.quran-reading-2",
          "title": {
            "id": "Baca",
            "en": "Read"
          },
          "body": {
            "id": "Baca perlahan sambil menunjuk setiap gabungan.",
            "en": "Read slowly while pointing to each combination."
          }
        },
        {
          "id": "step.quran-reading-3",
          "title": {
            "id": "Koreksi",
            "en": "Correct"
          },
          "body": {
            "id": "Dengarkan contoh dan catat bunyi yang perlu diulang.",
            "en": "Listen to a model and note sounds to repeat."
          }
        }
      ]
    }
