{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islamic-json.dev/v2/schemas/sources.schema.json",
  "title": "Islamic JSON v2 source registry",
  "type": "object",
  "required": ["schemaVersion", "type", "sources"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "type": { "const": "source-registry" },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/quranReference" },
          { "$ref": "#/$defs/hadithReference" },
          { "$ref": "#/$defs/book" },
          { "$ref": "#/$defs/article" },
          { "$ref": "#/$defs/webResource" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "base": {
      "type": "object",
      "required": ["id", "type", "citationLabel"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/semanticId" },
        "type": { "type": "string" },
        "citationLabel": { "$ref": "common.schema.json#/$defs/localizedString" },
        "notes": { "$ref": "common.schema.json#/$defs/localizedString" }
      }
    },
    "quranReference": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "type": { "const": "quran-reference" },
            "locator": {
              "type": "object",
              "required": ["surah", "ayah"],
              "properties": {
                "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
                "ayah": { "type": "integer", "minimum": 1 },
                "ayahEnd": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "hadithReference": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "type": { "const": "hadith-reference" },
            "locator": {
              "type": "object",
              "required": ["collection"],
              "properties": {
                "collection": { "type": "string", "minLength": 1 },
                "number": { "type": ["string", "integer"], "minLength": 1 },
                "book": { "type": "string", "minLength": 1 },
                "chapter": { "type": "string", "minLength": 1 }
              },
              "anyOf": [{ "required": ["number"] }, { "required": ["book", "chapter"] }],
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "book": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "authors", "publisher", "year"],
          "properties": {
            "type": { "const": "book" },
            "title": { "type": "string", "minLength": 1 },
            "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "publisher": { "type": "string", "minLength": 1 },
            "year": { "type": "integer", "minimum": 1 },
            "isbn": { "type": "string", "pattern": "^(?:[0-9Xx][- ]*){10,13}$" },
            "locator": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "article": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "authors", "publication", "year"],
          "properties": {
            "type": { "const": "article" },
            "title": { "type": "string", "minLength": 1 },
            "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "publication": { "type": "string", "minLength": 1 },
            "year": { "type": "integer", "minimum": 1 },
            "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "webResource": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["title", "url", "accessedAt"],
          "properties": {
            "type": { "const": "web-resource" },
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "publisher": { "type": "string", "minLength": 1 },
            "accessedAt": { "type": "string", "format": "date" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
