{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islamic-json.dev/v2/schemas/icons.schema.json",
  "title": "Islamic JSON v2 semantic icon registry",
  "type": "object",
  "required": ["schemaVersion", "type", "icons"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "type": { "const": "icon-registry" },
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/icon" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "provider",
        "sourceName",
        "version",
        "license",
        "attribution",
        "redistributable"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "attribution": { "type": "string", "minLength": 1 },
        "redistributable": { "const": true }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "fontAwesome": {
          "type": "object",
          "required": ["name", "style", "provenance"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "style": { "enum": ["solid", "regular", "brands"] },
            "provenance": { "$ref": "#/$defs/provenance" }
          },
          "additionalProperties": false
        },
        "materialSymbols": {
          "type": "object",
          "required": ["name", "style", "provenance"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            },
            "style": { "enum": ["outlined", "rounded", "sharp"] },
            "provenance": { "$ref": "#/$defs/provenance" }
          },
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["path", "viewBox", "style", "provenance"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/relativePath" },
        "viewBox": { "const": "0 0 24 24" },
        "style": { "enum": ["monochrome-fill", "monochrome-stroke"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "icon": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:general|faith|worship|purification|quran-learning|daily-life|location|time)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": { "$ref": "common.schema.json#/$defs/localizedString" },
        "fallbackId": {
          "type": ["string", "null"],
          "pattern": "^(?:general|faith|worship|purification|quran-learning|daily-life|location|time)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "providers": { "$ref": "#/$defs/providers" },
        "asset": { "$ref": "#/$defs/asset" }
      },
      "additionalProperties": false
    }
  }
}
