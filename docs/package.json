{
  "name": "islamic-json-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev .",
    "prepare-data": "node scripts/prepare-data.mjs",
    "docs:build": "vitepress build .",
    "build": "npm run prepare-data && npm run docs:build",
    "preview": "vitepress preview .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.6"
  }
}
